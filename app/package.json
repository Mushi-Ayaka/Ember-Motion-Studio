{
  "name": "ember-motion-studio",
  "version": "5.9.1",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "main": "dist-electron/main.js",
  "description": "Professional Dynamic Vector Graphics Engine for Broadcast Animation",
  "author": "Jonatan Baron",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/bundle-remotion.js && node scripts/run-builder.js",
    "docker:deps": "docker compose run --rm deps",
    "docker:deps:build": "docker compose build",
    "preview": "vite preview",
    "lint": "eslint src electron --ext ts,tsx"
  },
  "dependencies": {
    "@dvge/runtime-bridge": "6.0.0-beta.1",
    "@remotion/bundler": "^4.0.465",
    "@remotion/paths": "^4.0.465",
    "@remotion/player": "^4.0.465",
    "@remotion/renderer": "^4.0.465",
    "@sentry/electron": "^7.13.0",
    "dotenv": "^17.4.2",
    "execa": "^5.1.1",
    "lucide-react": "^1.16.0",
    "node-machine-id": "^1.1.12",
    "papaparse": "^5.5.3",
    "posthog-js": "^1.376.0",
    "posthog-node": "^5.35.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remotion": "^4.0.465",
    "systeminformation": "^5.31.6",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "rcedit": "5.0.2",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.7"
  },
  "build": {
    "appId": "com.jonatanbaron.embermotionstudio",
    "productName": "Ember Motion Studio",
    "directories": {
      "output": "../release/${version}"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/@remotion/compositor-win32-x64-msvc/**",
      "node_modules/@esbuild/**",
      "node_modules/esbuild/**",
      "src/remotion/**",
      "public/**",
      "remotion-bundle/**",
      "electron/resources/**",
      "*.md"
    ],
    "files": [
      "dist/**",
      "dist-electron/**",
      "src/remotion/**",
      "public/**",
      "remotion-bundle/**",
      "electron/resources/**",
      "node_modules/**",
      "package.json",
      "EULA.txt",
      "LICENSE",
      "*.md"
    ],
    "icon": "public/logo-square.png",
    "win": {
      "icon": "public/logo-square.png",
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "license": "EULA.txt",
      "artifactName": "EmberMotionStudio-Setup-${version}.${ext}"
    },
    "compression": "store"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "electron",
      "esbuild",
      "protobufjs"
    ]
  }
}
